#!/usr/bin/env node
import fs from 'node:fs/promises';
import path from 'node:path';
import { request } from 'playwright-core';
import { productLinks, parsePradaProduct, pradaSupplement, pradaModelProductLinks } from '../../common/prada-product.js';
import { downloadAndOptimizeImage } from '../../common/image-processor.js';
import { normalizeProductCode } from '../../common/product-normalizer.js';

if (process.env.CRAWL_MODE !== 'deterministic-only' || process.env.LUXURY_PIPELINE_GUARD !== 'enabled' || process.env.LUXURY_NETWORK_ISOLATED !== 'enabled') throw new Error('guarded isolated pipeline required');
const args=process.argv.slice(2),arg=name=>args[args.indexOf(name)+1];
const allowedArguments=new Set(['--country-config','--discover','--urls-file','--expand-variants','--inspect-metadata','--exclude-codes-file','--prices-only','--build-price-index','--probe-price-options','--targets-file','--inspect-linked-candidates']);
if(args.some(value=>value.startsWith('--')&&!allowedArguments.has(value)))throw new Error('unreviewed diagnostic mode is disabled');
const config=JSON.parse(await fs.readFile(arg('--country-config'),'utf8'));
const inspectCandidates=args.includes('--inspect-linked-candidates');
if(inspectCandidates&&(config.country!=='KR'||!args.includes('--prices-only')||!args.includes('--urls-file')))throw new Error('read-only Korean candidate inspection required');
config.maxDiscoveryPages??=30;
const map=JSON.parse(await fs.readFile(new URL('./parent-model-map.json',import.meta.url),'utf8'));
const run=process.env.CRAWL_RUN_DIR,artifact=path.join(run,'artifacts');
await fs.mkdir(artifact,{recursive:true});
const context=await request.newContext({proxy:{server:process.env.LUXURY_NETWORK_PROXY},timeout:config.navigationTimeoutMs});
const rows=[],summaries=[];
let stage='BOOT';
let pages=0,lastRequest=0;
const fail=code=>Object.assign(new Error(code),{failureCode:code});
async function get(url) {
  let retries=0;
  for(let hop=0;hop<4;hop++){
    const destination=new URL(url);
    stage=destination.pathname.endsWith('.model.json')?'OPTIONS':destination.pathname.includes('/p/')?'DETAIL':destination.pathname.includes('/c/')?'LISTING':'HOME';
    if(destination.protocol!=='https:'||!config.allowedHosts.includes(destination.hostname))throw fail('UNAUTHORIZED_URL');
    if(destination.hostname==='api.prada.com'&&destination.pathname!=='/anon/approductfilteringprd/PRD_04_07_GetGroupedProducts')throw fail('UNAUTHORIZED_PRODUCT_API');
    if(++pages>250)throw fail('PAGE_LIMIT');
    const slot=Math.max(Date.now(),lastRequest+300);lastRequest=slot;const delay=slot-Date.now();if(delay>0)await new Promise(resolve=>setTimeout(resolve,delay));
    let response;
    try{response=await context.get(url,{maxRedirects:0});}
    catch(error){
      const transient=/ECONNRESET|socket hang up|connection reset|socket disconnected|request aborted/i.test(error.message??'');
      if(transient&&retries<config.maxRetriesPerUrl){retries++;hop--;await new Promise(resolve=>setTimeout(resolve,1000*retries));continue;}
      const reason=transient?'NETWORK_RESET':/proxy/i.test(error.message??'')?'PROXY_FAILED':/certificate|SSL|EPROTO/i.test(error.message??'')?'TLS_FAILED':/Timeout|timeout/i.test(error.message??'')?'TIMEOUT':'REQUEST_FAILED';
      throw fail(`${stage}_${reason}`);
    }
    if([403,429].includes(response.status()))throw fail('ACCESS_BLOCKED');
    if([502,503,504].includes(response.status())&&retries<config.maxRetriesPerUrl){retries++;hop--;await new Promise(resolve=>setTimeout(resolve,1000*retries));continue;}
    if(![301,302,303,307,308].includes(response.status()))return response;
    url=new URL(response.headers().location,url).href;
  }
  throw fail('REDIRECT_LIMIT');
}
function summarize(row,status=row.priceStatus){return {brand:'prada',country:config.country,parentModel:(row.parentModel??'KR reference').slice(0,120),variantCode:row.normalizedCode,price:row.price,currency:config.currency,status,officialUrl:row.officialUrl.length<=500?row.officialUrl:config.listingUrls[0]};}
async function saveSummary(){for(let offset=0;offset<Math.max(summaries.length,1);offset+=25)await fs.writeFile(path.join(run,offset===0?'summary.json':`summary-${offset/25}.json`),JSON.stringify(summaries.slice(offset,offset+25)));}
try{
  if(args.includes('--probe-price-options')){
    if(config.country==='KR'||!args.includes('--urls-file')||!args.includes('--targets-file'))throw fail('INVALID_OPTION_PROBE');
    const urls=JSON.parse(await fs.readFile(arg('--urls-file'),'utf8')),targets=JSON.parse(await fs.readFile(arg('--targets-file'),'utf8'));
    if(!Array.isArray(urls)||!urls.length||urls.length>20||!Array.isArray(targets)||targets.length>500||targets.some(c=>typeof c!=='string'||!/^[A-Z0-9]+$/.test(c)))throw fail('OPTION_PROBE_LIMIT');
    const found=new Map(),wanted=new Set(targets);const home=await get(`https://www.prada.com${config.referenceDetailPrefix.replace(/\/p\/$/,'.html')}`);if(!home.ok())throw fail('HOME_HTTP_FAILED');
    for(const url of urls){if(new URL(url).origin!=='https://www.prada.com'||!new URL(url).pathname.startsWith(config.referenceDetailPrefix))throw fail('WRONG_COUNTRY_URL');const response=await get(`${url}.model.json`);if(response.status()===404)continue;if(!response.ok())throw fail('OPTION_MODEL_HTTP_FAILED');if(!new URL(response.url()).pathname.startsWith(config.referenceDetailPrefix))throw fail('WRONG_COUNTRY_REDIRECT');const text=await response.text();await fs.writeFile(path.join(run,'raw',`${normalizeProductCode(new URL(url).pathname.split('/').at(-1))}-options.json`),text);let model;try{model=JSON.parse(text);}catch{throw fail('INVALID_OPTION_MODEL');}for(const[code,target]of pradaModelProductLinks(model,url,config.country.toLowerCase()))if(wanted.has(code)&&new URL(target).pathname.startsWith(config.referenceDetailPrefix))found.set(code,target);const extra=pradaSupplement(model,{normalizedCode:normalizeProductCode(new URL(url).pathname.split('/').at(-1))});for(const code of extra.codes){const normalized=normalizeProductCode(code);if(wanted.has(normalized)&&!found.has(normalized)){const target=new URL(url);target.pathname=target.pathname.replace(/[^/]+$/,code);found.set(normalized,target.href);}}}
    await fs.writeFile(path.join(artifact,'price-option-index.json'),JSON.stringify([...found]));for(const code of targets)summaries.push({brand:'prada',country:config.country,parentModel:'공식 국가 옵션 대조',variantCode:code,price:null,currency:config.currency,status:found.has(code)?'OFFICIAL_OPTION_PRESENT':'OPTION_NOT_FOUND',officialUrl:found.get(code)??urls[0]});
  }else if(args.includes('--build-price-index')){
    if(config.country==='KR')throw fail('FOREIGN_INDEX_ONLY');
    const home=`https://www.prada.com${config.referenceDetailPrefix.replace(/\/p\/$/,'.html')}`;
    const response=await get(home),html=await response.text();if(!response.ok())throw fail('HOME_HTTP_FAILED');await fs.writeFile(path.join(run,'raw','home.html'),html);
    const categories=new Map();for(const match of html.matchAll(/href=["']([^"']+)["']/gi)){try{const url=new URL(match[1].replaceAll('&amp;','&'),home),id=url.pathname.match(/\/c\/(10062|10143)[A-Z]{2}$/)?.[1];if(id&&url.origin==='https://www.prada.com'&&url.pathname.startsWith(`/${config.country.toLowerCase()}/`))categories.set(id,url.href);}catch{}}
    if(categories.size!==2)throw fail('CATEGORY_PATH_MISSING');
    const links=new Map();for(const category of categories.values()){let exhausted=false;for(let page=1;page<=config.maxDiscoveryPages;page++){const url=page===1?category:`${category}/page/${page}`,response=await get(url),html=await response.text();await fs.writeFile(path.join(run,'raw',`category-${categories.get('10062')===category?'women':'men'}-${page}.html`),html);if(response.status()===404&&page>1){exhausted=true;break;}if(!response.ok())throw fail('LISTING_HTTP_FAILED');const found=productLinks(html,response.url(),config.country.toLowerCase()),fresh=[...found].filter(([code])=>!links.has(code));if(page===1&&!found.size)throw fail('EMPTY_LISTING');if(page>1&&!fresh.length){exhausted=true;break;}for(const [code,url]of found)links.set(code,url);}if(!exhausted)throw fail('DISCOVERY_LIMIT');}
    await fs.writeFile(path.join(artifact,'price-url-index.json'),JSON.stringify([...links]));summaries.push({brand:'prada',country:config.country,parentModel:'한국 기준 가격 URL 대조용',variantCode:'INDEX',price:null,currency:config.currency,status:`INDEXED_${links.size}`,officialUrl:home});
  }else if(args.includes('--discover')){
    if(config.country!=='KR')throw fail('FOREIGN_DISCOVERY_PROHIBITED');
    const links=new Map();
    for(const listing of config.listingUrls){
      let exhausted=false;
      for(let page=1;page<=config.maxDiscoveryPages;page++){
        const url=page===1?listing:`${listing}/page/${page}`;
        const response=await get(url),html=await response.text();
        await fs.writeFile(path.join(run,'raw',`listing-${config.listingUrls.indexOf(listing)}-${page}.html`),html);
        if(response.status()===404&&page>1){exhausted=true;break;}
        if(!response.ok())throw fail('LISTING_HTTP_FAILED');
        const found=productLinks(html,response.url(),config.country.toLowerCase());
        const newLinks=[...found].filter(([code])=>!links.has(code));
        if(page===1&&!found.size)throw fail('EMPTY_LISTING');
        if(page>1&&!newLinks.length){exhausted=true;break;}
        for(const [code,productUrl] of found)links.set(code,productUrl);
      }
      if(!exhausted)throw fail('DISCOVERY_LIMIT');
    }
    await fs.writeFile(path.join(artifact,'discovered-urls.json'),JSON.stringify([...links.values()]));
    summaries.push({brand:'prada',country:'KR',parentModel:'한국 공식 목록',variantCode:'DISCOVERY',price:null,currency:'KRW',status:`DISCOVERED_${links.size}`,officialUrl:config.listingUrls[0]});
  }else{
    if(!args.includes('--urls-file'))throw fail('EXPLICIT_BATCH_REQUIRED');
    const urls=JSON.parse(await fs.readFile(arg('--urls-file'),'utf8'));
    if(!Array.isArray(urls)||!urls.length||urls.length>config.maxProductsPerRun)throw fail('PRODUCT_LIMIT');
    if(config.country!=='KR'||args.includes('--prices-only')){
      if(config.country!=='KR'){const home=await get(`https://www.prada.com${config.referenceDetailPrefix.replace(/\/p\/$/,'.html')}`);if(!home.ok())throw fail('HOME_HTTP_FAILED');if(!new URL(home.url()).pathname.startsWith(`/${config.country.toLowerCase()}/`))throw fail('WRONG_COUNTRY_REDIRECT');}
      const unique=[...new Map(urls.map(url=>[normalizeProductCode(decodeURIComponent(new URL(url).pathname.split('/').at(-1))),url])).values()];
      const results=new Array(unique.length);let cursor=0;
      await Promise.all(Array.from({length:Math.min(2,unique.length)},async()=>{
        while(cursor<unique.length){const index=cursor++,url=unique[index],code=normalizeProductCode(decodeURIComponent(new URL(url).pathname.split('/').at(-1)));
          if(!new URL(url).pathname.startsWith(config.referenceDetailPrefix))throw fail('WRONG_COUNTRY_URL');
          const response=await get(url),html=await response.text();await fs.writeFile(path.join(run,'raw',`${code}.html`),html);
          if(response.status()===404&&(config.country!=='KR'||inspectCandidates)){results[index]={country:config.country,currency:config.currency,normalizedCode:code,productName:null,price:null,priceStatus:'page_not_found',officialUrl:url,checkedAt:new Date().toISOString()};continue;}
          if(!response.ok())throw Object.assign(fail(`DETAIL_HTTP_${response.status()}`),{failedUrl:url});if(!new URL(response.url()).pathname.startsWith(config.referenceDetailPrefix)){
            if((config.country!=='KR'||inspectCandidates)&&new URL(response.url()).origin==='https://www.prada.com'&&new URL(response.url()).pathname.startsWith(`/${config.country.toLowerCase()}/`)){results[index]={country:config.country,currency:config.currency,normalizedCode:code,productName:null,price:null,priceStatus:'price_unavailable',officialUrl:url,checkedAt:new Date().toISOString()};continue;}
            throw fail('WRONG_COUNTRY_REDIRECT');
          }
          try{results[index]=parsePradaProduct(html,url,config,map);}catch(error){if(error.failureCode==='EXACT_PRODUCT_MISSING'&&((config.country!=='KR'&&error.observedCode)||inspectCandidates)){results[index]={country:config.country,currency:config.currency,normalizedCode:code,productName:null,price:null,priceStatus:'price_unavailable',officialUrl:url,checkedAt:new Date().toISOString()};}else throw error;}
        }
      }));
      rows.push(...results);summaries.push(...results.map(row=>summarize(row)));await fs.writeFile(path.join(artifact,'records.json'),JSON.stringify(rows));
    }else{
    const queue=[...urls],seen=new Set();
    if(args.includes('--exclude-codes-file')){if(config.country!=='KR'||!args.includes('--expand-variants'))throw fail('INVALID_EXCLUSION_MODE');const excluded=JSON.parse(await fs.readFile(arg('--exclude-codes-file'),'utf8'));if(!Array.isArray(excluded)||excluded.some(code=>typeof code!=='string'||!/^[A-Z0-9]+$/.test(code)))throw fail('INVALID_EXCLUSION_CODES');for(const code of excluded)seen.add(code);}
    let processed=0;
    while(queue.length){
      const url=queue.shift(),code=normalizeProductCode(decodeURIComponent(new URL(url).pathname.split('/').at(-1)));
      if(seen.has(code))continue;seen.add(code);
      if(++processed>config.maxProductsPerRun)throw fail('VARIANT_BATCH_LIMIT');
      if(!new URL(url).pathname.startsWith(config.referenceDetailPrefix))throw fail('WRONG_COUNTRY_URL');
      const response=await get(url),html=await response.text();
      await fs.writeFile(path.join(run,'raw',`${code}.html`),html);
      if(response.status()===404&&config.country!=='KR'){
        const row={country:config.country,currency:config.currency,normalizedCode:code,productName:null,price:null,priceStatus:'page_not_found',officialUrl:url,checkedAt:new Date().toISOString()};rows.push(row);summaries.push(summarize(row));continue;
      }
      if(!response.ok())throw fail('DETAIL_HTTP_FAILED');
      if(!new URL(response.url()).pathname.startsWith(config.referenceDetailPrefix))throw fail('WRONG_COUNTRY_REDIRECT');
      const row=parsePradaProduct(html,url,config,map);
      if(config.country==='KR'&&!args.includes('--prices-only')){
        const modelResponse=await get(`${url}.model.json`);
        if(!modelResponse.ok())throw fail('PRODUCT_MODEL_HTTP_FAILED');
        const modelText=await modelResponse.text();await fs.writeFile(path.join(run,'raw',`${code}-product-model.json`),modelText);
        const extra=pradaSupplement(JSON.parse(modelText),row);
        if(extra.color)row.colorDisplay=row.colorOriginal=extra.color;
        if(extra.material)row.materialDisplay=row.materialOriginal=extra.material;
        for(const field of ['widthMm','heightMm','depthMm'])if(extra[field]!=null)row[field]=extra[field];
        if(args.includes('--expand-variants'))for(const childCode of extra.codes){const target=new URL(url);target.pathname=target.pathname.replace(/[^/]+$/,childCode);if(!seen.has(normalizeProductCode(childCode))&&!queue.includes(target.href))queue.push(target.href);}
        if(args.includes('--inspect-metadata'))for(const [field,label]of [['colorDisplay','COLOR'],['materialDisplay','MATERIAL'],['widthMm','WIDTH'],['heightMm','HEIGHT'],['depthMm','DEPTH']])summaries.push({...summarize(row),price:null,status:`${label}_${row[field]==null?'MISSING':'CONFIRMED'}`});
      }
      if(config.country==='KR'&&!args.includes('--prices-only')){
        Object.assign(row,await downloadAndOptimizeImage({request:context},row.sourceImageUrl,artifact));
        if(args.includes('--expand-variants'))for(const [childCode,childUrl] of productLinks(html,url,'kr'))if(childCode.startsWith(row.styleCode)&&!seen.has(childCode)&&!queue.includes(childUrl))queue.push(childUrl);
      }
      rows.push(row);summaries.push(summarize(row));
      await saveSummary();
    }
    await fs.writeFile(path.join(artifact,'records.json'),JSON.stringify(rows));
    }
  }
}catch(error){
  const network=error.message?.match(/net::(ERR_[A-Z_]+)/)?.[1];
  const code=error.failureCode??(network?`${stage}_${network}`:/Timeout|timeout/i.test(error.message)?`${stage}_TIMEOUT`:`${stage}_${String(error.name??'ERROR').toUpperCase()}`);
  const failedCode=error.failedUrl?normalizeProductCode(decodeURIComponent(new URL(error.failedUrl).pathname.split('/').at(-1))):'FAILED';
  summaries.push({brand:'prada',country:config.country,parentModel:'run',variantCode:failedCode,price:null,currency:config.currency,status:code.slice(0,40),officialUrl:error.failedUrl?.length<=500?error.failedUrl:config.listingUrls[0]});
  await fs.writeFile(path.join(run,'failure.json'),JSON.stringify({failureCode:code}));process.exitCode=1;
}finally{await saveSummary();await context.dispose();}
