#!/usr/bin/env node
import fs from 'node:fs/promises';
import path from 'node:path';
import { chromium, request } from 'playwright-core';
import { productLinks, parsePradaProduct, pradaSupplement } from '../../common/prada-product.js';
import { downloadAndOptimizeImage } from '../../common/image-processor.js';
import { normalizeProductCode } from '../../common/product-normalizer.js';

if (process.env.CRAWL_MODE !== 'deterministic-only' || process.env.LUXURY_PIPELINE_GUARD !== 'enabled' || process.env.LUXURY_NETWORK_ISOLATED !== 'enabled') throw new Error('guarded isolated pipeline required');
const args=process.argv.slice(2),arg=name=>args[args.indexOf(name)+1];
const allowedArguments=new Set(['--country-config','--discover','--urls-file','--expand-variants','--inspect-metadata']);
if(args.some(value=>value.startsWith('--')&&!allowedArguments.has(value)))throw new Error('unreviewed diagnostic mode is disabled');
const config=JSON.parse(await fs.readFile(arg('--country-config'),'utf8'));
const map=JSON.parse(await fs.readFile(new URL('./parent-model-map.json',import.meta.url),'utf8'));
const run=process.env.CRAWL_RUN_DIR,artifact=path.join(run,'artifacts');
await fs.mkdir(artifact,{recursive:true});
const context=await request.newContext({proxy:{server:process.env.LUXURY_NETWORK_PROXY},timeout:config.navigationTimeoutMs});
const rows=[],summaries=[];
let browser;
let stage='BOOT';
let pages=0,lastRequest=0;
const fail=code=>Object.assign(new Error(code),{failureCode:code});
async function get(url) {
  for(let hop=0;hop<4;hop++){
    const destination=new URL(url);
    if(destination.protocol!=='https:'||!config.allowedHosts.includes(destination.hostname))throw fail('UNAUTHORIZED_URL');
    if(destination.hostname==='api.prada.com'&&destination.pathname!=='/anon/approductfilteringprd/PRD_04_07_GetGroupedProducts')throw fail('UNAUTHORIZED_PRODUCT_API');
    if(++pages>250)throw fail('PAGE_LIMIT');
    const delay=300-(Date.now()-lastRequest);if(delay>0)await new Promise(resolve=>setTimeout(resolve,delay));lastRequest=Date.now();
    const response=await context.get(url,{maxRedirects:0});
    if([403,429].includes(response.status()))throw fail('ACCESS_BLOCKED');
    if(![301,302,303,307,308].includes(response.status()))return response;
    url=new URL(response.headers().location,url).href;
  }
  throw fail('REDIRECT_LIMIT');
}
function summarize(row,status=row.priceStatus){return {brand:'prada',country:config.country,parentModel:row.parentModel??'KR reference',variantCode:row.normalizedCode,price:row.price,currency:config.currency,status,officialUrl:row.officialUrl};}
async function saveSummary(){for(let offset=0;offset<Math.max(summaries.length,1);offset+=25)await fs.writeFile(path.join(run,offset===0?'summary.json':`summary-${offset/25}.json`),JSON.stringify(summaries.slice(offset,offset+25)));}
try{
  if(args.includes('--discover')){
    if(config.country!=='KR')throw fail('FOREIGN_DISCOVERY_PROHIBITED');
    const links=new Map();
    for(const listing of config.listingUrls){
      let exhausted=false;
      for(let page=1;page<=config.maxDiscoveryPages;page++){
        const url=page===1?listing:`${listing}/page/${page}`;
        const response=await get(url),html=await response.text();
        await fs.writeFile(path.join(run,'raw',`listing-${config.listingUrls.indexOf(listing)}-${page}.html`),html);
        if(response.status()===404&&page>1){exhausted=true;break;}
        if(!response.ok())throw fail('LISTING_HTTP_FAILED');
        const found=productLinks(html,response.url(),config.country.toLowerCase());
        const newLinks=[...found].filter(([code])=>!links.has(code));
        if(page===1&&!found.size)throw fail('EMPTY_LISTING');
        if(page>1&&!newLinks.length){exhausted=true;break;}
        for(const [code,productUrl] of found)links.set(code,productUrl);
      }
      if(!exhausted)throw fail('DISCOVERY_LIMIT');
    }
    await fs.writeFile(path.join(artifact,'discovered-urls.json'),JSON.stringify([...links.values()]));
    summaries.push({brand:'prada',country:'KR',parentModel:'한국 공식 목록',variantCode:'DISCOVERY',price:null,currency:'KRW',status:`DISCOVERED_${links.size}`,officialUrl:config.listingUrls[0]});
  }else{
    if(!args.includes('--urls-file'))throw fail('EXPLICIT_BATCH_REQUIRED');
    const urls=JSON.parse(await fs.readFile(arg('--urls-file'),'utf8'));
    if(!Array.isArray(urls)||!urls.length||urls.length>config.maxProductsPerRun)throw fail('PRODUCT_LIMIT');
    const queue=[...urls],seen=new Set();
    while(queue.length){
      const url=queue.shift(),code=normalizeProductCode(decodeURIComponent(new URL(url).pathname.split('/').at(-1)));
      if(seen.has(code))continue;seen.add(code);
      if(seen.size>config.maxProductsPerRun)throw fail('VARIANT_BATCH_LIMIT');
      if(!new URL(url).pathname.startsWith(config.referenceDetailPrefix))throw fail('WRONG_COUNTRY_URL');
      const response=await get(url),html=await response.text();
      await fs.writeFile(path.join(run,'raw',`${code}.html`),html);
      if(response.status()===404&&config.country!=='KR'){
        const row={country:config.country,currency:config.currency,normalizedCode:code,productName:null,price:null,priceStatus:'page_not_found',officialUrl:url,checkedAt:new Date().toISOString()};rows.push(row);summaries.push(summarize(row));continue;
      }
      if(!response.ok())throw fail('DETAIL_HTTP_FAILED');
      const row=parsePradaProduct(html,url,config,map);
      if(config.country==='KR'){
        const modelResponse=await get(`${url}.model.json`);
        if(!modelResponse.ok())throw fail('PRODUCT_MODEL_HTTP_FAILED');
        const modelText=await modelResponse.text();await fs.writeFile(path.join(run,'raw',`${code}-product-model.json`),modelText);
        const extra=pradaSupplement(JSON.parse(modelText),row);
        if(extra.color)row.colorDisplay=row.colorOriginal=extra.color;
        if(extra.material)row.materialDisplay=row.materialOriginal=extra.material;
        for(const field of ['widthMm','heightMm','depthMm'])if(extra[field]!=null)row[field]=extra[field];
        if(args.includes('--expand-variants'))for(const childCode of extra.codes){const target=new URL(url);target.pathname=target.pathname.replace(/[^/]+$/,childCode);if(!seen.has(normalizeProductCode(childCode))&&!queue.includes(target.href))queue.push(target.href);}
        if(args.includes('--inspect-metadata'))for(const [field,label]of [['colorDisplay','COLOR'],['materialDisplay','MATERIAL'],['widthMm','WIDTH'],['heightMm','HEIGHT'],['depthMm','DEPTH']])summaries.push({...summarize(row),price:null,status:`${label}_${row[field]==null?'MISSING':'CONFIRMED'}`});
      }
      if(args.includes('--inspect-options')){
        const model=await get(`${url}.model.json`),modelText=await model.text();await fs.writeFile(path.join(run,'raw',`${code}-store-model.json`),modelText);
        const ids=new Set();const find=value=>{if(typeof value==='string'&&/^[\[{]/.test(value)){try{find(JSON.parse(value));}catch{}return;}if(!value||typeof value!=='object')return;for(const [key,child]of Object.entries(value)){if(key.toLowerCase()==='storeid'&&/^[0-9]+$/.test(String(child)))ids.add(String(child));if(child&&['object','string'].includes(typeof child))find(child);}};
        try{find(JSON.parse(modelText));}catch{}
        summaries.push({...summarize(row),price:null,status:`STORE_IDS_${ids.size}`});
        const target=new URL('https://api.prada.com/anon/approductfilteringprd/PRD_04_07_GetGroupedProducts');target.search=new URLSearchParams({product:row.originalCode,functionalities:'eoSizeSelector',locale:'ko_KR',lang:'ko_KR'});
        const api=ids.size===1?await context.get(target.href,{headers:{storeId:[...ids][0]},maxRedirects:0}):await get(target.href),body=await api.text();await fs.writeFile(path.join(run,'raw',`${code}-options.json`),body);
        summaries.push({...summarize(row),price:null,status:`OPTIONS_HTTP_${api.status()}`});
        if(!api.ok()){for(const word of ['brand','header','parameter','locale','language','country','authorization','missing','product'])if(new RegExp(word,'i').test(body))summaries.push({...summarize(row),price:null,status:`OPTIONS_ERROR_${word.toUpperCase()}`});try{const text=JSON.stringify(JSON.parse(body)).replace(/\\"/g,'"');const header=text.match(/header\s*[:=-]?\s*['"]?([A-Za-z][A-Za-z0-9_-]{1,40})/i)?.[1];if(header)summaries.push({...summarize(row),price:null,status:`REQUIRED_${header.toUpperCase()}`.slice(0,40)});}catch{}}
        if(api.ok())try{let n=0;const fields=new Set();const visit=value=>{if(!value||typeof value!=='object')return;if(Object.values(value).some(v=>typeof v==='string'&&/^\d[A-Z]{2}\d{3}_/.test(v))&&n++<4)for(const field of Object.keys(value))fields.add(field);for(const child of Object.values(value))if(child&&typeof child==='object')visit(child);};const data=JSON.parse(body);visit(data);for(const field of [...Object.keys(data),...fields].slice(0,55))summaries.push({...summarize(row),price:null,status:`OPT_${field.replace(/[^a-zA-Z]/g,'').toUpperCase()}`.slice(0,40)});summaries.push({...summarize(row),price:null,status:`OPTION_PRODUCTS_${n}`});}catch{}
      }
      if(args.includes('--inspect-browser')){
        stage='BROWSER_CONNECT';
        browser??=await chromium.connectOverCDP(process.env.CRAWL_CDP_URL);const tab=await browser.contexts()[0].newPage();const apis=new Set();
        tab.on('request',req=>{const target=new URL(req.url());if(target.hostname==='api.prada.com'&&target.pathname.includes('GetGroupedProducts')){for(const header of Object.keys(req.headers()))summaries.push({...summarize(row),price:null,status:`HDR_${header.replace(/[^a-zA-Z]/g,'').toUpperCase()}`.slice(0,40)});summaries.push({...summarize(row),price:null,status:`METHOD_${req.method()}`});}if(['xhr','fetch'].includes(req.resourceType())&&target.href.length<=500&&!/key|token|auth/i.test(target.search))apis.add(target.href);});
        const pending=[];
        tab.on('response',response=>{if(response.url().includes('GetGroupedProducts'))pending.push((async()=>{const raw=await response.text();await fs.writeFile(path.join(run,'raw',`${code}-browser-options.json`),raw);summaries.push({...summarize(row),price:null,status:`BROWSER_OPTIONS_${response.status()}`});try{const value=JSON.parse(raw),fields=new Set(Object.keys(value));const visit=obj=>{if(!obj||typeof obj!=='object')return;for(const [key,v]of Object.entries(obj)){if(/product|color|colour|material|size|part|dimension|height|width|depth|sku/i.test(key))fields.add(key);if(v&&typeof v==='object')visit(v);}};visit(value);for(const field of [...fields].slice(0,45))summaries.push({...summarize(row),price:null,status:`OPT_${field.replace(/[^a-zA-Z]/g,'').toUpperCase()}`.slice(0,40)});}catch{}})().catch(()=>{}));});
        await tab.route('**/*',route=>{const req=route.request(),target=new URL(req.url());return !config.allowedHosts.includes(target.hostname)||(target.hostname==='api.prada.com'&&!target.pathname.includes('GetGroupedProducts'))||['image','font','media'].includes(req.resourceType())?route.abort():route.continue();});
        stage='BROWSER_NAVIGATE';await tab.goto(url,{waitUntil:'domcontentloaded',timeout:30000});await tab.waitForTimeout(2500);
        await Promise.all(pending);for(const api of apis)summaries.push({...summarize(row),price:null,status:'OBSERVED_PRODUCT_API',officialUrl:api});await tab.close();
      }
      if(args.includes('--inspect-model')){
        const api=await get(`${url}.model.json`),body=await api.text();await fs.writeFile(path.join(run,'raw',`${code}-model.json`),body);
        summaries.push({...summarize(row),price:null,status:`MODEL_HTTP_${api.status()}`});
        if(api.ok())try{const fields=new Set();const visit=value=>{if(typeof value==='string'&&/^[\[{]/.test(value)){try{visit(JSON.parse(value));}catch{}return;}if(!value||typeof value!=='object')return;for(const [field,child] of Object.entries(value)){if(/color|colour|material|dimension|size|height|width|depth|variant|product|partnumber/i.test(field))fields.add(field);if(child&&(['object','string'].includes(typeof child)))visit(child);}};visit(JSON.parse(body));for(const field of [...fields].slice(0,75))summaries.push({...summarize(row),price:null,status:`FIELD_${field.replace(/[^a-zA-Z]/g,'').toUpperCase()}`.slice(0,40)});}catch{}
      }
      if(config.country==='KR'){
        Object.assign(row,await downloadAndOptimizeImage({request:context},row.sourceImageUrl,artifact));
        if(args.includes('--expand-variants'))for(const [childCode,childUrl] of productLinks(html,url,'kr'))if(childCode.startsWith(row.styleCode)&&!seen.has(childCode)&&!queue.includes(childUrl))queue.push(childUrl);
      }
      rows.push(row);summaries.push(summarize(row));
      await saveSummary();
    }
    await fs.writeFile(path.join(artifact,'records.json'),JSON.stringify(rows));
  }
}catch(error){
  const network=error.message?.match(/net::(ERR_[A-Z_]+)/)?.[1];
  const code=error.failureCode??(network?`${stage}_${network}`:/Timeout|timeout/i.test(error.message)?`${stage}_TIMEOUT`:`${stage}_${String(error.name??'ERROR').toUpperCase()}`);
  summaries.push({brand:'prada',country:config.country,parentModel:'run',variantCode:'FAILED',price:null,currency:config.currency,status:code,officialUrl:config.listingUrls[0]});
  await fs.writeFile(path.join(run,'failure.json'),JSON.stringify({failureCode:code}));process.exitCode=1;
}finally{await saveSummary();await context.dispose();if(browser)await browser.close();}
