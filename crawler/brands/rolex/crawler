#!/usr/bin/env node
import {probeOfficialSite} from '../../common/official-site-probe.js';
import {collectReference} from '../../common/jewelry-watch-collection.js';
import {discoverRolexLocales} from '../../common/rolex-locales.js';
import fs from 'node:fs/promises';
import {collectVanCleefPrices} from '../../common/van-cleef-foreign.js';
if(process.argv.includes('--discover-locales'))await discoverRolexLocales(JSON.parse(await fs.readFile(process.argv[3])));
else if(JSON.parse(await fs.readFile(process.argv[3])).country!=='KR')await collectVanCleefPrices(JSON.parse(await fs.readFile(process.argv[3])));
else if(process.argv.some(v=>v.startsWith('--probe-')))await probeOfficialSite();else await collectReference();
