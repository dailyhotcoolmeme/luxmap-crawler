#!/usr/bin/env node
import {runBrandCollection} from '../../common/hermes-collection.js';
import {probeOfficialSite} from '../../common/official-site-probe.js';
import {discoverHermesReference,collectHermesForeignPrices,collectHermesSitemapPrices,collectHermesSearchPrices} from '../../common/hermes-reference-collection.js';
import {collectHermesReferenceBatch,recoverHermesListingSample} from '../../common/hermes-reference-batch.js';
import {probeHermesImageProperties} from '../../common/hermes-image-properties-probe.js';
if(process.argv.includes('--image-refresh-file')){
 const fs=await import('node:fs/promises');
 const {refreshImages}=await import('../../common/image-refresh.js');
 const args=process.argv.slice(2);
 if(args.length!==4||args[0]!=='--country-config'||args[2]!=='--image-refresh-file')throw Error('INVALID_IMAGE_REFRESH_MODE');
 await refreshImages(JSON.parse(await fs.readFile(args[1],'utf8')),args[3]);
}
else if(process.argv.includes('--prices-search-offset'))await collectHermesSearchPrices();
else if(process.argv.includes('--prices-sitemap-offset'))await collectHermesSitemapPrices();
else if(process.argv.includes('--prices-offset'))await collectHermesForeignPrices();
else if(process.argv.includes('--audit-reference')){
 const {auditOfficialReferenceCatalog}=await import('../../../scripts/audit-official-reference.mjs');
 process.exitCode=(await auditOfficialReferenceCatalog({brand:'hermes'})).exitCode;
}
else if(process.argv.includes('--probe-product-api')){
 const {probeHermesProductApi}=await import('../../common/hermes-product-api-probe.js');
 await probeHermesProductApi();
}
else if(process.argv.includes('--probe-product-dependencies')){
 const {probeHermesProductDependencies}=await import('../../common/hermes-product-dependencies-probe.js');
 await probeHermesProductDependencies();
}
else if(process.argv.includes('--probe-published-script')||process.argv.includes('--probe-product-chunk')){
 const {probePublishedScript}=await import('../../common/published-script-probe.js');
 await probePublishedScript();
}
else if(process.argv.includes('--recover-source-run'))await recoverHermesListingSample();
else if(process.argv.includes('--discover-reference'))await discoverHermesReference();
else if(process.argv.includes('--batch-offset'))await collectHermesReferenceBatch();
else if(process.argv.includes('--probe-image-properties'))await probeHermesImageProperties();
else if(process.argv.some(value=>value.startsWith('--probe-')))await probeOfficialSite();
else await runBrandCollection('hermes');
